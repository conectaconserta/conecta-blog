---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

/* ─────────────────────────────────────────────
   Layout para landings de trafego pago.

   Visual igual ao BaseLayout, mas SEM NENHUM LINK que saia da pagina:
   o menu aponta para ancoras das secoes e o rodape nao tem navegacao.
   Isso preserva a atribuicao — todo lead que converte veio desta pagina.

   Todo link de WhatsApp usa a mesma mensagem, recebida via prop.
   ───────────────────────────────────────────── */

interface Props {
  title: string;
  description: string;
  googleNoindex?: boolean;
  /* Numero e mensagem unicos de toda a pagina */
  whatsNumber: string;
  whatsMessage: string;
  /* Ancoras do menu: [{ href: '#servicos', label: 'Serviços' }] */
  sections?: { href: string; label: string }[];
  /* Rotulo enviado ao GA4 junto de cada clique */
  gaLabel?: string;
}

const {
  title,
  description,
  googleNoindex = false,
  whatsNumber,
  whatsMessage,
  sections = [],
  gaLabel = 'landing',
} = Astro.props;

const whatsLink = `https://wa.me/${whatsNumber}?text=${encodeURIComponent(whatsMessage)}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEO title={title} description={description} googleNoindex={googleNoindex} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KZQJ1SKWSJ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KZQJ1SKWSJ');
    </script>
    <slot name="head" />
  </head>

  <body>
    <!-- Cabeçalho: logo sem link, menu de âncoras, CTA de WhatsApp -->
    <header class="lp-header">
      <div class="container">
        <img
          src="/images/logo-header.png"
          alt="Conecta Phone"
          class="lp-logo"
          width="160"
          height="40"
        />

        <nav id="lp-nav">
          {sections.map(s => <a href={s.href}>{s.label}</a>)}
        </nav>

        <a
          href={whatsLink}
          class="lp-header-cta"
          target="_blank"
          rel="noopener noreferrer"
          data-lead
          data-origem="menu"
        >
          WhatsApp
        </a>

        <button class="lp-hamburger" id="lp-hamburger" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Rodapé: só informação, sem navegação -->
    <footer class="lp-footer">
      <div class="container">
        <div class="lp-footer-grid">
          <div>
            <img
              src="/images/footer-logo.png"
              alt="Conecta Phone"
              class="lp-footer-logo"
              width="160"
              height="40"
            />
            <p>
              Assistência técnica especializada em Apple: iPhone, iPad, MacBook e
              Apple Watch. Qualidade e garantia em cada reparo.
            </p>
          </div>

          <div>
            <h3>Onde estamos</h3>
            <ul>
              <li>Av. Antônio de Góes, 14<br />Pina, Recife – PE</li>
              <li>Seg–Sex: 09h–18h30</li>
              <li>Sáb: 09h–17h</li>
            </ul>
          </div>

          <div>
            <h3>Falar com a gente</h3>
            <ul>
              <li>(81) 99186-2060</li>
              <li>
                <a
                  href={whatsLink}
                  class="lp-footer-whats"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-lead
                  data-origem="rodape"
                >
                  Chamar no WhatsApp
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="lp-copyright">
          <p>© {year} Conecta Phone — Todos os direitos reservados. Recife, PE.</p>
        </div>
      </div>
    </footer>

    <!-- Botão flutuante de WhatsApp -->
    <a
      href={whatsLink}
      class="lp-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
      data-lead
      data-origem="flutuante"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Menu mobile -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('lp-hamburger');
        var nav = document.getElementById('lp-nav');
        if (!btn || !nav) return;
        btn.addEventListener('click', function () {
          var open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          btn.classList.toggle('open', !open);
          nav.classList.toggle('mobile-open', !open);
        });
        /* fecha ao escolher uma seção */
        nav.addEventListener('click', function (e) {
          if (e.target.tagName === 'A') {
            btn.setAttribute('aria-expanded', 'false');
            btn.classList.remove('open');
            nav.classList.remove('mobile-open');
          }
        });
      })();
    </script>

    <!-- Conversão: todo clique de WhatsApp é atribuído a esta landing -->
    <script is:inline define:vars={{ gaLabel }}>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('a[data-lead]');
        if (el) {
          gtag('event', 'whatsapp_click', {
            event_category: 'conversao',
            event_label: gaLabel,
            origem: el.getAttribute('data-origem') || 'geral',
          });
        }
      });
    </script>

    <!-- Scroll reveal -->
    <script is:inline>
      (function () {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        var ios = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              Array.from(entry.target.children).forEach(function (child, i) {
                child.style.opacity = '0';
                child.style.transform = 'translateY(24px)';
                child.style.transition = 'opacity 0.55s cubic-bezier(0.16,1,0.3,1) ' + (i * 75) + 'ms, transform 0.55s cubic-bezier(0.16,1,0.3,1) ' + (i * 75) + 'ms';
                requestAnimationFrame(function () {
                  requestAnimationFrame(function () {
                    child.style.opacity = '1';
                    child.style.transform = 'translateY(0)';
                  });
                });
              });
              ios.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });

        function init() {
          document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
          document.querySelectorAll('.reveal-stagger').forEach(function (el) { ios.observe(el); });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  /* ── Cabeçalho ── */
  .lp-header {
    background: #fff;
    padding: 1rem 0;
    border-bottom: 1px solid #E8EFF4;
    box-shadow: 0 1px 12px rgba(20, 51, 79, 0.07);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .lp-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .lp-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  #lp-nav {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
    justify-content: center;
  }

  #lp-nav a {
    color: #14334F;
    padding: 0.45rem 0.75rem;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.88rem;
    text-decoration: none;
    position: relative;
    transition: color 0.2s;
    white-space: nowrap;
  }

  #lp-nav a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0.75rem;
    right: 0.75rem;
    height: 2px;
    background: #1FC3FF;
    border-radius: 2px;
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  #lp-nav a:hover { color: #0099CC; text-decoration: none; }
  #lp-nav a:hover::after { transform: scaleX(1); }

  .lp-header-cta {
    background: #25D366;
    color: #fff;
    padding: 0.5rem 1.1rem;
    border-radius: 100px;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .lp-header-cta:hover {
    background: #1fad54;
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.38);
  }

  .lp-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    flex-shrink: 0;
  }

  .lp-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #14334F;
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }

  .lp-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .lp-hamburger.open span:nth-child(2) { opacity: 0; }
  .lp-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 900px) {
    .lp-hamburger { display: flex; }
    .lp-header-cta { display: none; }

    #lp-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-top: 1px solid #E8EFF4;
      box-shadow: 0 8px 24px rgba(20, 51, 79, 0.12);
      flex-direction: column;
      align-items: stretch;
      padding: 0.75rem;
      gap: 0;
      z-index: 999;
    }

    #lp-nav.mobile-open { display: flex; }

    #lp-nav a {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.95rem;
    }
  }

  /* o cabeçalho é sticky: compensa a altura dele ao pular para uma âncora */
  main section[id] { scroll-margin-top: 80px; }

  /* ── Rodapé ── */
  .lp-footer {
    background: var(--dark);
    color: #9CA3AF;
    padding: 3.5rem 0 1.5rem;
    margin-top: 0;
  }

  .lp-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .lp-footer-logo {
    height: 42px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .lp-footer p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: #6B7280;
  }

  .lp-footer h3 {
    color: #F3F4F6;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .lp-footer ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .lp-footer li {
    font-size: 0.875rem;
    color: #9CA3AF;
    line-height: 1.6;
  }

  .lp-footer-whats {
    color: #4ADE80;
    text-decoration: none;
    transition: color 0.2s;
  }

  .lp-footer-whats:hover { color: #86EFAC; text-decoration: none; }

  .lp-copyright {
    border-top: 1px solid #374151;
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.8rem;
    color: #6B7280;
  }

  @media (max-width: 900px) {
    .lp-footer-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 540px) {
    .lp-footer-grid { grid-template-columns: 1fr; }
  }

  /* ── Botão flutuante ── */
  .lp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: #25D366;
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .lp-float:hover {
    transform: scale(1.08);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.28);
  }

  .lp-float svg { width: 30px; height: 30px; }
</style>
