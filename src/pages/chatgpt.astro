      },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'Conserto de iPhone, iPad, MacBook e Apple Watch em Recife',
      serviceType: 'Assistência técnica Apple',
      provider: { '@id': `${pageUrl}#business` },
      areaServed: { '@type': 'City', name: 'Recife' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Reparos Apple',
        itemListElement: devices.map(d => ({
          '@type': 'OfferCatalog',
          name: `Conserto de ${d.nome}`,
          itemListElement: d.reparos.map(r => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: `${r} — ${d.nome}` },
          })),
