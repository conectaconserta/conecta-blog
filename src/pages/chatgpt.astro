const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${pageUrl}#business`,
      name: 'Conecta Phone',
      description:
        'Assistência técnica especializada em produtos Apple no Recife: conserto de iPhone, iPad, MacBook e Apple Watch.',
      url: pageUrl,
      telephone: '+55-81-99186-2060',
      image: `${siteUrl}/images/logo.png`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Av. Antônio de Góes, 14',
        addressLocality: 'Recife',
        addressRegion: 'PE',
        postalCode: '51110-150',
        addressCountry: 'BR',
      },
      areaServed: {
        '@type': 'City',
        name: 'Recife',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
