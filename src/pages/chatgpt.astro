---
import BaseLayout from '../layouts/BaseLayout.astro';

/* ─────────────────────────────────────────────
   Landing exclusiva para ChatGPT Ads.
   Mesmo padrão visual das páginas /conserto/[slug],
   porém do geral Apple em vez de um aparelho específico.
   ───────────────────────────────────────────── */

const whatsNumber = '5581991862060';
const waLink = (msg: string) =>
  `https://wa.me/${whatsNumber}?text=${encodeURIComponent(msg)}`;

const whatsappUrl = waLink('Olá! Vim pelo ChatGPT e preciso de um orçamento grátis');

const title = 'Assistência Técnica Apple em Recife — iPhone, iPad, MacBook e Apple Watch';
const description =
  'Conserto de iPhone, iPad, MacBook e Apple Watch em Recife. Diagnóstico gratuito, peças certificadas, garantia de 90 dias e coleta e entrega. Fale no WhatsApp.';

/* Serviços do geral Apple — reaproveitam as mesmas fotos das páginas /conserto/ */
const services = [
  { nome: 'Troca de Tela',            img: '/images/services/tela.jpg' },
  { nome: 'Troca de Bateria',         img: '/images/services/bateria.jpg' },
  { nome: 'Conector de Carga',        img: '/images/services/conector.jpg' },
  { nome: 'Dano por Líquido',         img: '/images/services/agua.jpg' },
  { nome: 'Câmera Traseira/Frontal',  img: '/images/services/camera.jpg' },
  { nome: 'Face ID / Touch ID',       img: '/images/services/faceid.jpg' },
  { nome: 'Alto-falante/Microfone',   img: '/images/services/audio.jpg' },
  { nome: 'Vidro Traseiro',           img: '/images/services/vidro-traseiro.jpg' },
  { nome: 'Reparo de Placa-mãe',      img: '/images/services/placa-mae.jpg' },
  { nome: 'Botões',                   img: '/images/conserto/botao-iphone.jpg' },
  { nome: 'Tela de MacBook',          img: '/images/services/mb-tela.jpg' },
  { nome: 'Teclado de MacBook',       img: '/images/services/mb-teclado.jpg' },
  { nome: 'Trackpad de MacBook',      img: '/images/services/mb-trackpad.jpg' },
  { nome: 'Upgrade de SSD',           img: '/images/services/mb-ssd.jpg' },
  { nome: 'Tela de iPad',             img: '/images/services/ipad-tela.jpg' },
  { nome: 'Bateria de iPad',          img: '/images/services/ipad-bateria.jpg' },
  { nome: 'Tela de Apple Watch',      img: '/images/services/aw-tela.jpg' },
  { nome: 'Bateria de Apple Watch',   img: '/images/services/aw-bateria.jpg' },
];

/* Aparelhos atendidos, agrupados por linha */
const grupos = [
  {
    device: 'iPhone',
    models: [
      'iPhone 6 e 6s', 'iPhone 7', 'iPhone 8', 'iPhone X', 'iPhone XR', 'iPhone XS',
      'iPhone 11', 'iPhone 12', 'iPhone 13', 'iPhone 14', 'iPhone 15', 'iPhone 16',
      'iPhone 17', 'Linhas Plus, Pro e Pro Max', 'iPhone SE',
    ],
  },
  {
    device: 'iPad',
    models: ['iPad', 'iPad Air', 'iPad mini', 'iPad Pro 11"', 'iPad Pro 12,9"', 'Todas as gerações'],
  },
  {
    device: 'MacBook',
    models: ['MacBook Air', 'MacBook Pro', 'Intel', 'Apple Silicon M1', 'M2', 'M3', 'M4'],
  },
  {
    device: 'Apple Watch',
    models: ['Series 1 à Series 10', 'Apple Watch SE', 'Apple Watch Ultra', 'Nike e Hermès'],
  },
];

const diferenciais = [
  { titulo: 'Diagnóstico gratuito', texto: 'Avaliamos o aparelho sem custo antes de qualquer intervenção.' },
  { titulo: 'Peças certificadas', texto: 'Componentes de qualidade compatíveis com os padrões originais.' },
  { titulo: 'Garantia de 90 dias', texto: 'Todo reparo tem cobertura contra defeitos no componente substituído.' },
  { titulo: 'Coleta e entrega', texto: 'Buscamos e devolvemos seu aparelho em Recife sem custo adicional.' },
  { titulo: 'Parcelamento 6x sem juros', texto: 'Pague no cartão em até 6 parcelas sem acréscimo.' },
  { titulo: '+800 avaliações no Google', texto: 'Referência em assistência Apple em Recife há anos.' },
];

const reviews = [
  {
    texto: 'Excelente serviço e atendimento. Foi bastante rápido e eficiente! Muito bem atendida pelo Marcos, excelente profissional.',
    autor: 'Wictor Amorim', quando: 'Há 16 semanas', inicial: 'W',
  },
  {
    texto: 'Recomendo demais! Sempre que preciso, eles resolvem tudo super rápido e sempre entregam no mesmo dia. O atendimento é excelente, a equipe é super prestativa e explica tudo direitinho. Já virei cliente fiel! 💙',
    autor: 'Madu', quando: 'Há 2 semanas', inicial: 'M',
  },
  {
    texto: 'Fiz um conserto de placa do meu iPhone e fui muito bem atendida. Tinha um prazo mais curto e eles conseguiram me atender no dia que precisava. Deu tudo certo! Super recomendo.',
    autor: 'Laura Lakitini', quando: 'Há 15 semanas', inicial: 'L',
  },
  {
    texto: 'Levei meu iPhone 12 para troca de bateria e da tampa traseira. Fui muito bem atendida pelo WhatsApp e o retorno foi rápido. No presencial o espaço é agradável e me entregaram antes do prazo. Nota 10 💗',
    autor: 'Alyce', quando: 'Há 4 semanas', inicial: 'A',
  },
  {
    texto: 'Precisei consertar a traseira e a lente do meu iPhone 14 Pro Max. Vieram buscar na minha residência e devolveram tudo pronto no mesmo dia. O atendimento foi muito atencioso e me passou muita confiança.',
    autor: 'Thamyres Santos', quando: 'Há 7 semanas', inicial: 'T',
  },
  {
    texto: 'Experiência maravilhosa desde o primeiro contato. A opção de delivery é segura, o motoqueiro é educado. O serviço é impecável. Voltarei a fazer serviços com eles.',
    autor: 'Juliana Luna', quando: 'Há 2 semanas', inicial: 'J',
  },
  {
    texto: 'Troquei a cabine traseira do 12 e o resultado superou as expectativas. Ficou muito bom mesmo, capricho total. Atendimento maravilhoso, atencioso e profissional. Nota 10!',
    autor: 'Ralyssa Cirne', quando: 'Há 6 semanas', inicial: 'R',
  },
];

const faqs = [
  {
    q: 'Quanto tempo demora o conserto?',
    a: 'A maioria dos reparos — tela, bateria, conector de carga — fica pronta no mesmo dia, em 1 a 2 horas. Serviços de placa ou dano por líquido precisam de mais tempo de bancada, e informamos o prazo exato logo após o diagnóstico.',
  },
  {
    q: 'O conserto tem garantia?',
    a: 'Sim. Todo reparo realizado na Conecta Phone tem 90 dias de garantia contra defeitos no serviço e na peça aplicada.',
  },
  {
    q: 'Vocês buscam o aparelho na minha casa ou no trabalho?',
    a: 'Sim, temos coleta e entrega em Recife e região, sem custo adicional. Você combina o endereço pelo WhatsApp, buscamos o aparelho e devolvemos pronto.',
  },
  {
    q: 'As peças são originais?',
    a: 'Trabalhamos com peças originais Apple e OEM premium. Antes de aprovar o serviço, explicamos qual peça será usada no seu caso e por quê.',
  },
  {
    q: 'Quanto custa o orçamento?',
    a: 'Nada. O diagnóstico e o orçamento são gratuitos, sem compromisso. Como o valor muda bastante conforme o modelo e o tipo de reparo, o preço é informado no atendimento — chame no WhatsApp que respondemos rápido.',
  },
  {
    q: 'Dá para parcelar?',
    a: 'Sim, em até 6x sem juros no cartão de crédito. Também aceitamos Pix, débito e dinheiro.',
  },
  {
    q: 'Meu aparelho não liga. Ainda tem conserto?',
    a: 'Na maioria dos casos, sim. Fazemos reparo em nível de placa, o que resolve boa parte dos aparelhos que outras assistências já descartaram. Como o diagnóstico é gratuito, vale trazer para avaliação.',
  },
  {
    q: 'Onde vocês ficam?',
    a: 'Na Av. Antônio de Góes, 14 — Pina, Recife/PE. Atendemos de segunda a sexta das 09h às 18h30 e aos sábados das 09h às 17h.',
  },
];

const siteUrl = 'https://conecta-blog.vercel.app';
const pageUrl = `${siteUrl}/chatgpt`;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'Assistência técnica Apple em Recife',
      description,
      serviceType: 'Conserto de iPhone, iPad, MacBook e Apple Watch',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Conecta Phone',
        telephone: '+55-81-99186-2060',
        image: `${siteUrl}/images/fachada.jpg`,
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Av. Antônio de Góes, 14',
          addressLocality: 'Recife',
          addressRegion: 'PE',
          postalCode: '51110-150',
          addressCountry: 'BR',
        },
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
            opens: '09:00',
            closes: '18:30',
          },
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: 'Saturday',
            opens: '09:00',
            closes: '17:00',
          },
        ],
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.9',
          reviewCount: '800',
          bestRating: '5',
        },
      },
      areaServed: { '@type': 'City', name: 'Recife' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Reparos Apple',
        itemListElement: services.map(s => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.nome },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout title={title} description={description} googleNoindex={true}>
  <script type="application/ld+json" set:html={schema} />

  <!-- Hero — fachada da loja com overlay -->
  <header class="conserto-hero" style="background-image: url('/images/fachada.jpg')">
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <p class="device-label">Assistência Apple</p>
      <h1>Conserto de iPhone, iPad, MacBook e Apple Watch em Recife</h1>
      <p class="hero-sub">
        Assistência técnica especializada só em Apple, com loja física no Pina.
        Diagnóstico gratuito, peças certificadas e reparo no mesmo dia para a
        maioria dos serviços.
      </p>
      <div class="hero-actions">
        <a
          href={whatsappUrl}
          class="btn-hero"
          target="_blank"
          rel="noopener noreferrer"
          data-lead
          data-origem="hero"
        >
          Orçamento grátis via WhatsApp
        </a>
        <span class="hero-badge">Diagnóstico gratuito · Garantia 90 dias</span>
      </div>
    </div>
  </header>

  <!-- Serviços -->
  <section class="section services-section">
    <div class="container">
      <h2 class="section-title reveal">Serviços disponíveis</h2>
      <p class="section-sub reveal">
        Atendimento no mesmo dia para a maioria dos reparos. Peças certificadas com garantia.
        Toque no serviço para falar com um técnico.
      </p>
      <div class="services-grid reveal-stagger">
        {services.map(s => (
          <a
            class="service-card"
            href={waLink(`Olá! Vim pelo ChatGPT e quero um orçamento grátis de ${s.nome.toLowerCase()}`)}
            target="_blank"
            rel="noopener noreferrer"
            data-lead
            data-origem="servico"
          >
            <img
              class="service-card-photo"
              src={s.img}
              alt={s.nome}
              width="300"
              height="200"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 480px) calc(50vw - 1rem), 180px"
            />
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <span class="service-name">{s.nome}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Aparelhos atendidos -->
  <section class="section models-section">
    <div class="container">
      <h2 class="section-title reveal">Aparelhos atendidos</h2>
      <p class="section-sub reveal">Trabalhamos exclusivamente com produtos Apple.</p>
      <div class="grupos reveal-stagger">
        {grupos.map(g => (
          <div class="grupo">
            <h3 class="grupo-device">{g.device}</h3>
            <div class="models-list">
              {g.models.map(m => <span class="model-chip">{m}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Conteúdo -->
  <section class="section content-section">
    <div class="container">
      <div class="article-body conserto-content reveal">
        <h2>Assistência técnica Apple em Recife</h2>
        <p>
          A Conecta Phone é uma assistência técnica especializada exclusivamente em
          produtos Apple, com loja física na Av. Antônio de Góes, no Pina, em Recife.
          Há mais de cinco anos consertamos <strong>iPhone, iPad, MacBook e Apple Watch</strong>,
          com mais de 800 avaliações no Google e nota 4,9.
        </p>
        <p>
          Como não dividimos a bancada com outras marcas, nossos técnicos conhecem a
          fundo o comportamento de cada aparelho — do iPhone 6 ao iPhone 17, dos MacBooks
          Intel aos com chip Apple Silicon. Isso encurta o diagnóstico e reduz a chance
          de troca desnecessária de peça.
        </p>

        <h2>Como funciona o atendimento</h2>
        <p>
          Todo atendimento começa pelo WhatsApp. Você descreve o aparelho e o que está
          acontecendo, e nossa equipe já adianta o que costuma causar aquele sintoma.
          Em seguida você escolhe entre trazer o aparelho à loja ou pedir a
          <strong> coleta e entrega em Recife</strong>, sem custo adicional.
        </p>
        <p>
          O diagnóstico é gratuito e feito antes de qualquer intervenção. Só depois de
          você aprovar é que o reparo começa. A maioria dos serviços — troca de tela,
          bateria e conector de carga — fica pronta no mesmo dia, em 1 a 2 horas de bancada.
        </p>

        <h2>Reparos mais procurados</h2>
        <p>
          <strong>Tela quebrada ou sem toque</strong> é o serviço mais comum em iPhone e
          iPad. Também atendemos muito <strong>bateria viciada</strong>, aparelhos que
          <strong> não carregam</strong> por problema no conector, <strong>dano por líquido</strong>,
          <strong> Face ID e Touch ID</strong> que pararam de funcionar, câmera embaçada,
          alto-falante sem som e vidro traseiro trincado.
        </p>
        <p>
          Em MacBook, os casos frequentes são tela com linhas ou manchas, bateria inchada,
          teclado e trackpad com defeito e aparelhos que não ligam. No Apple Watch,
          tela descolando e bateria inchada — que exigem atenção rápida por segurança.
        </p>
        <p>
          Quando outras assistências dizem que não tem conserto, ainda vale trazer:
          fazemos <strong>reparo em nível de placa</strong>, que recupera boa parte dos
          aparelhos já descartados. Como o diagnóstico não custa nada, não há risco em avaliar.
        </p>

        <h2>Garantia e formas de pagamento</h2>
        <p>
          Todo reparo sai com <strong>90 dias de garantia</strong> contra defeitos no
          serviço e na peça aplicada. O pagamento pode ser feito em até
          <strong> 6x sem juros</strong> no cartão de crédito, além de Pix, débito e dinheiro.
        </p>
        <p>
          Os valores variam bastante conforme o modelo e o tipo de reparo, então o orçamento
          é sempre passado no atendimento, depois do diagnóstico. Chame no WhatsApp que
          respondemos rápido, no horário comercial.
        </p>
      </div>
    </div>
  </section>

  <!-- Diferenciais -->
  <section class="section diferenciais-section">
    <div class="container">
      <h2 class="section-title reveal">Por que escolher a Conecta Phone?</h2>
      <div class="diferenciais-grid reveal-stagger">
        {diferenciais.map(d => (
          <div class="diferencial-card">
            <strong>{d.titulo}</strong>
            <p>{d.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Avaliações -->
  <section class="section reviews-section">
    <div class="container">
      <div class="reviews-header reveal">
        <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div>
          <h2 class="section-title" style="margin-bottom:0.25rem;">O que nossos clientes dizem</h2>
          <div class="reviews-rating-line">
            <span class="stars-display">★★★★★</span>
            <span class="reviews-score">4,9</span>
            <span class="reviews-count">· mais de 800 avaliações no Google</span>
          </div>
        </div>
      </div>

      <div class="reviews-track reveal-stagger">
        {reviews.map(r => (
          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">"{r.texto}"</p>
            <div class="review-author">
              <span class="review-avatar">{r.inicial}</span>
              <div>
                <strong>{r.autor}</strong>
                <span>{r.quando}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="container faq-inner">
      <h2 class="section-title reveal">Perguntas frequentes</h2>
      <p class="section-sub reveal">O que mais perguntam antes de trazer o aparelho.</p>
      <div class="faq-list reveal">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>
              {f.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Seu aparelho Apple precisa de reparo?</h2>
      <p>Diagnóstico gratuito, reparo no mesmo dia e garantia de 90 dias. Fale agora com um técnico.</p>
      <a
        href={whatsappUrl}
        class="btn-white"
        target="_blank"
        rel="noopener noreferrer"
        data-lead
        data-origem="cta-final"
      >
        Chamar no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<!-- Tracking específico da campanha (o BaseLayout já dispara o whatsapp_click genérico) -->
<script is:inline>
  document.addEventListener('click', function (e) {
    var el = e.target.closest('a[data-lead]');
    if (el) {
      gtag('event', 'lead_chatgpt', {
        event_category: 'conversao',
        event_label: 'chatgpt_ads',
        origem: el.getAttribute('data-origem') || 'geral',
      });
    }
  });
</script>

<!-- Arraste horizontal no carrossel de avaliações -->
<script is:inline>
  (function () {
    var track = document.querySelector('.reviews-track');
    if (!track) return;
    var isDown = false, startX = 0, scrollLeft = 0;
    track.addEventListener('mousedown', function (e) {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', function () { isDown = false; });
    track.addEventListener('mouseup', function () { isDown = false; });
    track.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX);
    });
  })();
</script>

<style>
  /* ── Hero ── */
  .conserto-hero {
    position: relative;
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    background-color: var(--navy);
    color: #fff;
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: 5rem 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(10, 20, 40, 0.97) 0%,
      rgba(10, 20, 40, 0.90) 35%,
      rgba(10, 20, 40, 0.60) 60%,
      rgba(10, 20, 40, 0.15) 100%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 640px;
  }

  .device-label {
    display: inline-block;
    background: var(--cyan);
    color: var(--navy);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .conserto-hero h1 {
    color: #fff;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .hero-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-hero {
    display: inline-block;
    background: #25D366;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(37,211,102,0.35);
  }

  .btn-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37,211,102,0.45);
    text-decoration: none;
