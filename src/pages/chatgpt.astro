const waIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Conserto de iPhone, iPad, MacBook e Apple Watch em Recife | Conecta Phone</title>
    <meta
      name="description"
      content="Assistência técnica Apple em Recife: iPhone, iPad, MacBook e Apple Watch. Diagnóstico grátis, garantia de 90 dias, coleta e entrega. Fale no WhatsApp."
    />

    <!-- Destino de anúncio pago: fora do índice do Google (evita canibalizar o blog),
         mas liberado para os crawlers da OpenAI lerem a página. -->
    <meta name="googlebot" content="noindex, follow" />
    <meta name="theme-color" content="#0a1e30" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/images/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Conecta Phone" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="Conserto de iPhone, iPad, MacBook e Apple Watch em Recife" />
    <meta
      property="og:description"
      content="Assistência técnica Apple em Recife. Diagnóstico grátis, garantia de 90 dias, coleta e entrega. Fale no WhatsApp."
    />
    <meta property="og:image" content={`${siteUrl}/images/logo.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KZQJ1SKWSJ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KZQJ1SKWSJ');
    </script>

    <!-- ChatGPT Ads conversion pixel — colar aqui o código fornecido pela conta de anúncios -->
  </head>

  <body class="lp-body">
    <!-- ══ HERO ══ -->
    <header class="lp-hero">
      <div class="lp-glow" aria-hidden="true"></div>

      <div class="container lp-hero-inner">
        <img
          src="/images/footer-logo.png"
          alt="Conecta Phone"
          class="lp-logo"
          width="200"
          height="50"
        />

        <h1 class="lp-h1">
          <span class="lp-h1-line">Conserto de</span>
          <span class="rot" aria-label="iPhone, iPad, MacBook e Apple Watch">
            <span class="rot-track">
              {rotativos.map(d => <span class="grad">{d}</span>)}
              <span class="grad">{rotativos[0]}</span>
            </span>
          </span>
          <span class="lp-h1-line">em Recife</span>
        </h1>

        <p class="lp-lead">
          Assistência técnica especializada só em Apple. Diagnóstico gratuito,
          peças de qualidade e garantia de 90 dias em todos os reparos.
        </p>

        <div class="lp-rating">
          <svg class="lp-google" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span class="lp-stars">★★★★★</span>
          <strong>4,9</strong>
          <span class="lp-count">· mais de 800 avaliações no Google</span>
        </div>

        <a
          href={whatsLink}
          class="lp-cta"
          target="_blank"
          rel="noopener noreferrer"
          data-whats
          data-origem="hero"
        >
          <span class="lp-cta-icon" set:html={waIcon} />
          <span class="lp-cta-text">
            <strong>Falar no WhatsApp agora</strong>
            <em>Orçamento grátis em minutos</em>
          </span>
        </a>

        <ul class="lp-selos">
          {selos.map(s => <li>{s}</li>)}
        </ul>
      </div>
    </header>

    <main>
      <!-- ══ APARELHOS ══ -->
      <section class="section lp-devices" id="aparelhos">
        <div class="container">
          <h2 class="section-title reveal">Qual é o seu aparelho?</h2>
          <p class="section-subtitle reveal">
            Somos especializados exclusivamente em produtos Apple. Escolha o seu e fale
            direto com um técnico.
          </p>

          <div class="lp-device-grid reveal-stagger">
            {devices.map(d => (
              <article class="lp-device-card">
                <span class="lp-device-icon" set:html={d.icon} />
                <h3>{d.nome}</h3>
                <p class="lp-device-desc">{d.desc}</p>
                <ul class="lp-device-list">
                  {d.reparos.map(r => <li>{r}</li>)}
                </ul>
                <a
                  href={waLink(d.msg)}
                  class="btn lp-device-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-whats
                  data-origem={d.origem}
                >
                  Orçamento de {d.nome}
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ══ PROBLEMAS ══ -->
      <section class="section lp-problemas">
        <div class="container">
          <h2 class="section-title reveal">Problemas que resolvemos todo dia</h2>
          <p class="section-subtitle reveal">
            Se o seu caso está aqui, tem solução. Toque no problema e já abre o WhatsApp
            com a mensagem pronta.
          </p>

          <div class="lp-chips reveal-stagger">
            {problemas.map(p => (
              <a
                href={waLink(`Olá! Vim pelo ChatGPT. Meu aparelho Apple está com este problema: ${p.toLowerCase()}. Quero um orçamento grátis.`)}
                class="lp-chip"
                target="_blank"
                rel="noopener noreferrer"
                data-whats
                data-origem="problema"
              >
                {p}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ══ COMO FUNCIONA ══ -->
      <section class="section lp-passos">
        <div class="container">
          <h2 class="section-title reveal">Como funciona</h2>
          <p class="section-subtitle reveal">Três passos, sem burocracia e sem sair de casa se você preferir.</p>

          <div class="lp-passos-grid reveal-stagger">
            {passos.map(p => (
              <div class="lp-passo">
                <span class="lp-passo-n">{p.n}</span>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </div>
            ))}
          </div>

          <div class="lp-center reveal">
            <a
              href={whatsLink}
              class="btn"
              target="_blank"
              rel="noopener noreferrer"
              data-whats
              data-origem="passos"
            >
              Começar pelo WhatsApp
            </a>
          </div>
        </div>
      </section>

      <!-- ══ DIFERENCIAIS ══ -->
      <section class="section lp-why">
        <div class="container">
          <h2 class="section-title lp-title-light reveal">Por que a Conecta Phone</h2>
          <p class="section-subtitle lp-subtitle-light reveal">
            Mais de 5 anos consertando Apple no Recife, com loja física no Pina.
          </p>

          <div class="lp-why-grid reveal-stagger">
            {diferenciais.map(d => (
              <div class="lp-why-card">
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ══ AVALIAÇÕES ══ -->
      <section class="section lp-reviews">
        <div class="container">
          <div class="reviews-header reveal">
            <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
