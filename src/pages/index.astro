---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const whatsappUrl =
  'https://wa.me/5581991862060?text=Ol%C3%A1%2C%20vim%20do%20blog%20Conecta%20e%20preciso%20de%20um%20or%C3%A7amento%20gr%C3%A1tis';

// Faixa rotativa do título do hero
const heroWords = ['Celular', 'MacBook', 'Apple Watch', 'JBL'];

// Linhas atendidas — quadro de um lado, explicação do outro, alternando
const lines = [
  {
    name: 'iPhone',
    label: 'Conserte seu',
    href: '/conserto/iphone-17/',
    img: '/images/iphone.png',
    text: 'Do iPhone 7 ao 17: troca de tela, bateria, vidro traseiro, câmera, conector de carga e Face ID. Na maioria dos casos o reparo sai em até 1 hora — e você sabe qual peça vai no aparelho antes de autorizar.',
    cta: 'Ver serviços de iPhone',
  },
  {
    name: 'Apple Watch',
    label: 'Conserte seu',
    href: '/conserto/apple-watch-series/',
    img: '/images/apple-watch.png',
    text: 'Apple Watch Series, SE e Nike: tela e vidro, bateria, coroa digital e dano por líquido. Diagnóstico gratuito e orçamento antes de qualquer serviço.',
    cta: 'Ver serviços de Apple Watch',
  },
  {
    name: 'iPad',
    label: 'Conserte seu',
    href: '/conserto/ipad/',
    img: '/images/ipad.png',
    text: 'iPad, iPad Air, iPad mini e iPad Pro: tela e touch, bateria, conector de carga e câmera. Também recuperamos iPads que não ligam ou travaram no sistema.',
    cta: 'Ver serviços de iPad',
  },
  {
    name: 'MacBook',
    label: 'Conserte seu',
    href: '/conserto/macbook-pro/',
    img: '/images/macbook.png',
    text: 'MacBook Air e MacBook Pro: tela, bateria, teclado, trackpad e portas USB-C — com reparo em nível de placa quando o defeito não é de peça.',
    cta: 'Ver serviços de MacBook',
  },
  {
    name: 'Samsung',
    label: 'Conserte seu',
    href: '/conserto/samsung/',
    img: null,
    art: `<svg class="tile-art" viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="80" y="14" width="80" height="172" rx="16"/><circle cx="102" cy="44" r="9"/><circle cx="102" cy="68" r="9"/><circle cx="102" cy="92" r="9"/><circle cx="124" cy="44" r="2.5"/><path d="M106 160h28" opacity="0.5"/></svg>`,
    detail: 'Galaxy S · A · M',
    text: 'Galaxy S, S FE, S Ultra, A e M, além de Z Fold, Z Flip e Galaxy Tab: tela AMOLED, bateria, tampa traseira e conector de carga, com garantia de até 6 meses.',
    cta: 'Ver serviços de Samsung',
  },
  {
    name: 'Motorola',
    label: 'Conserte seu',
    href: '/conserto/motorola/',
    img: null,
    art: `<svg class="tile-art" viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="80" y="14" width="80" height="172" rx="16"/><rect x="92" y="28" width="40" height="40" rx="10"/><circle cx="104" cy="40" r="6"/><circle cx="120" cy="56" r="6"/><circle cx="120" cy="112" r="14"/><path d="M112 118l4-10 4 7 4-7 4 10"/></svg>`,
    detail: 'Moto G · Edge · Moto E',
    text: 'Moto G, Motorola Edge e Moto E: tela, bateria, conector de carga e formatação do sistema. Diagnóstico gratuito e coleta e entrega em Recife.',
    cta: 'Ver serviços de Motorola',
  },
  {
    name: 'JBL',
    label: 'Conserte sua',
    href: '/conserto/jbl/',
    img: null,
    art: `<svg class="tile-art" viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="28" y="62" width="184" height="80" rx="40"/><ellipse cx="68" cy="102" rx="22" ry="26"/><ellipse cx="68" cy="102" rx="9" ry="11"/><path d="M108 82v40M124 82v40M140 82v40M156 82v40M172 82v40" opacity="0.45"/><path d="M196 70c14 6 14 58 0 64" opacity="0.6"/></svg>`,
    detail: 'Flip · Charge · Xtreme · PartyBox',
    text: 'Caixas de som Flip, Charge, Xtreme, Boombox e PartyBox: bateria, conector de carga, alto-falante e reparo de placa. Atendimento na loja do Pina, com 3 meses de garantia.',
    cta: 'Ver serviços de JBL',
  },
];

const services = [
  {
    name: 'Troca de tela',
    desc: 'Tela trincada, com manchas ou sem toque. Antes de autorizar, você sabe se a tela é OLED, AMOLED ou LCD.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 6l6 6M11 14l4 4"/></svg>`,
  },
  {
    name: 'Bateria',
    desc: 'Bateria que não dura o dia, inchada ou que desliga sozinha. Na maioria dos casos, troca em cerca de 1 hora.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="16" height="10" rx="2"/><path d="M22 11v2M6 12h6"/></svg>`,
  },
  {
    name: 'Conector de carga',
    desc: 'Não carrega ou só carrega em certa posição. Muitas vezes uma limpeza técnica resolve, sem troca de peça.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 2v5M15 2v5M7 7h10v4a5 5 0 01-10 0V7zM12 16v6"/></svg>`,
  },
  {
    name: 'Dano por líquido',
    desc: 'Desligue, não carregue e traga o quanto antes. Fazemos a limpeza técnica e o tratamento da oxidação.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C12 2 5 9.5 5 14a7 7 0 0014 0c0-4.5-7-12-7-12z"/></svg>`,
  },
  {
    name: 'Placa e microssoldagem',
    desc: 'Aparelho que não liga, sem sinal ou que tomou água. Reparo do componente com defeito — vai além da troca de peça.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>`,
  },
  {
    name: 'Câmera',
    desc: 'Foto embaçada, câmera tremendo ou sem foco. Às vezes é só a lente; o diagnóstico separa uma coisa da outra.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
  },
  {
    name: 'Alto-falante e microfone',
    desc: 'Som baixo, chiado ou microfone falhando nas chamadas e nos áudios.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/></svg>`,
  },
  {
    name: 'Face ID e Touch ID',
    desc: 'Biometria que parou de funcionar. Recuperação com segurança, preservando o sensor do seu aparelho.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H5a2 2 0 00-2 2v2M17 3h2a2 2 0 012 2v2M7 21H5a2 2 0 01-2-2v-2M17 21h2a2 2 0 002-2v-2M9 10v1M15 10v1M12 10v4h-1M9 16a4 4 0 006 0"/></svg>`,
  },
  {
    name: 'Vidro traseiro',
    desc: 'Traseira de vidro trincada, trocada com acabamento caprichado e nova vedação.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="9.5" cy="6.5" r="1.5"/><path d="M14 13l-3 5"/></svg>`,
  },
];
---

<BaseLayout
  title="Assistência Técnica em Recife: Apple, Samsung, Motorola e JBL"
  description="Assistência técnica no Pina, Recife: iPhone, iPad, Apple Watch, MacBook, Samsung, Motorola e caixas JBL. Diagnóstico grátis e até 6 meses de garantia."
>
  <!-- Hero -->
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-text">
        <h1>
          <span class="sr-only">Conserto de celular, MacBook, Apple Watch e JBL em Recife</span>
          <span aria-hidden="true">
            Conserto de
            <span class="rotator">
              <span class="rotator-track">
                {heroWords.map(w => <span>{w}</span>)}
                <span>{heroWords[0]}</span>
              </span>
            </span>
          </span>
        </h1>
        <p class="home-hero-lead">
          Assistência técnica especializada em Apple, Samsung, Motorola e caixas de som JBL, no Pina, em Recife.
          Diagnóstico gratuito, reparo em até 1 hora na maioria dos casos e até 6 meses de garantia.
        </p>
        <div class="home-hero-actions">
          <a href={whatsappUrl} class="btn" target="_blank" rel="noopener noreferrer">Orçamento grátis</a>
          <a href="#assistencia" class="btn-outline">Ver o que consertamos</a>
        </div>
        <p class="home-hero-proof">
          <strong>4,9 no Google</strong> com mais de 800 avaliações · <strong>+20 mil</strong> aparelhos reparados desde 2021
        </p>
      </div>

      <figure class="home-hero-photo">
        <img
          src="/images/fachada.jpg"
          alt="Fachada da Conecta Phone na Av. Antônio de Góes, 14, no Pina, Recife"
          width="900"
          height="1600"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Nossa loja: Av. Antônio de Góes, 14 — Pina, Recife</figcaption>
      </figure>
    </div>
  </section>

  <!-- Assistência técnica especializada: linhas alternadas -->
  <section class="section expertise-section" id="assistencia">
    <div class="container">
      <h2 class="section-title reveal">Assistência Técnica Especializada</h2>
      <p class="section-subtitle reveal">Apple, Samsung, Motorola e JBL. Escolha o aparelho e veja os serviços e os modelos atendidos.</p>

      <div class="expertise-list">
        {lines.map(line => (
          <article class="expertise-row reveal">
            <a href={line.href} class="expertise-tile" tabindex="-1" aria-hidden="true">
              {line.img ? (
                <img src={line.img} alt="" width="600" height="600" loading="lazy" decoding="async" />
              ) : (
                <>
                  <Fragment set:html={line.art} />
                  <span class="tile-detail">{line.detail}</span>
                </>
              )}
              <span class="tile-caption">
                <span class="tile-label">{line.label}</span>
                <span class="tile-name">{line.name}</span>
              </span>
            </a>
            <div class="expertise-text">
              <h3>{line.name}</h3>
              <p>{line.text}</p>
              <a href={line.href} class="expertise-link">{line.cta} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Serviços -->
  <section class="section services-split">
    <div class="container services-layout">
      <div class="services-intro">
        <h2>Nossos serviços</h2>
        <p>
          Os reparos que mais fazemos, para Apple, Samsung e Motorola. Todos com diagnóstico gratuito,
          orçamento antes do serviço e garantia por escrito.
        </p>
        <a href={whatsappUrl} class="btn" target="_blank" rel="noopener noreferrer">Pedir orçamento</a>
      </div>

      <ul class="services-list">
        {services.map(service => (
          <li class="service-item">
            <span class="service-icon"><Fragment set:html={service.icon} /></span>
            <div>
              <h3>{service.name}</h3>
              <p>{service.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why us -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">Por que escolher a <span class="grad">Conecta Phone</span>?</h2>
      <p class="section-subtitle reveal">Desde 2021 no Pina, em Recife — mais de 20 mil aparelhos reparados e 4,9 estrelas no Google.</p>
      <div class="why-grid reveal-stagger">
        <div class="why-card">
          <h3>Diagnóstico Gratuito</h3>
          <p>Avaliamos seu aparelho sem custo e só cobramos se você aprovar o orçamento.</p>
        </div>
        <div class="why-card">
          <h3>Peças Certificadas</h3>
          <p>Peças de qualidade equivalente ou certificadas — e você sabe qual peça vai no aparelho antes de autorizar.</p>
        </div>
        <div class="why-card">
          <h3>Até 6 meses de garantia</h3>
          <p>Garantia por escrito em todo reparo: até 6 meses, e 3 meses para software e caixas JBL.</p>
        </div>
        <div class="why-card">
          <h3>Atendimento Rápido</h3>
          <p>Reparo em até 1 hora na maioria dos casos, com coleta e entrega em Recife.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section reviews-section">
    <div class="container">
      <div class="reviews-header reveal">
        <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div>
          <h2 class="section-title" style="margin-bottom:0.25rem;">O que nossos clientes dizem</h2>
          <div class="reviews-rating-line">
            <span class="stars-display">★★★★★</span>
            <span class="reviews-score">4,9</span>
            <span class="reviews-count">· mais de 800 avaliações no Google</span>
          </div>
        </div>
      </div>

      <div class="reviews-track reveal-stagger">

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Excelente serviço e atendimento. Foi bastante rápido e eficiente! Muito bem atendida pelo Marcos, excelente profissional."</p>
          <div class="review-author">
            <span class="review-avatar">W</span>
            <div>
              <strong>Wictor Amorim</strong>
              <span>Há 16 semanas</span>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Recomendo demais! Sempre que preciso, eles resolvem tudo super rápido e sempre entregam no mesmo dia. O atendimento é excelente, a equipe é super prestativa e explica tudo direitinho. Já virei cliente fiel! 💙"</p>
          <div class="review-author">
            <span class="review-avatar">M</span>
            <div>
              <strong>Madu</strong>
              <span>Há 2 semanas</span>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Fiz um conserto de placa do meu iPhone e fui muito bem atendida. Tinha um prazo mais curto e eles conseguiram me atender no dia que precisava. Deu tudo certo! Super recomendo."</p>
          <div class="review-author">
            <span class="review-avatar">L</span>
            <div>
              <strong>Laura Lakitini</strong>
              <span>Há 15 semanas</span>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Levei meu iPhone 12 para troca de bateria e da tampa traseira. Fui muito bem atendida pelo WhatsApp e o retorno foi rápido. No presencial o espaço é agradável e me entregaram antes do prazo. Nota 10 💗"</p>
          <div class="review-author">
            <span class="review-avatar">A</span>
            <div>
              <strong>Alyce</strong>
              <span>Há 4 semanas</span>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Precisei consertar a traseira e a lente do meu iPhone 14 Pro Max. Vieram buscar na minha residência e devolveram tudo pronto no mesmo dia. O atendimento foi muito atencioso e me passou muita confiança."</p>
          <div class="review-author">
            <span class="review-avatar">T</span>
            <div>
              <strong>Thamyres Santos</strong>
              <span>Há 7 semanas</span>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Experiência maravilhosa desde o primeiro contato. A opção de delivery é segura, o motoqueiro é educado. O serviço é impecável. Voltarei a fazer serviços com eles."</p>
          <div class="review-author">
            <span class="review-avatar">J</span>
            <div>
              <strong>Juliana Luna</strong>
              <span>Há 2 semanas</span>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Troquei a cabine traseira do 12 e o resultado superou as expectativas. Ficou muito bom mesmo, capricho total. Atendimento maravilhoso, atencioso e profissional. Nota 10!"</p>
          <div class="review-author">
            <span class="review-avatar">R</span>
            <div>
              <strong>Ralyssa Cirne</strong>
              <span>Há 6 semanas</span>
            </div>
          </div>
        </div>

      </div>

      <div style="text-align:center; margin-top:2.5rem;" class="reveal">
        <a href="https://share.google/rktOQ5pgkn5dEPEh1" class="btn-outline" target="_blank" rel="noopener noreferrer">
          Ver todas as avaliações no Google
        </a>
      </div>
    </div>
  </section>

  <!-- Latest posts -->
  <section class="section" style="background: var(--gray-50);">
    <div class="container">
      <h2 class="section-title reveal">Do nosso Blog</h2>
      <p class="section-subtitle reveal">Dicas, tutoriais e cuidados com o seu celular, tablet, relógio e notebook.</p>
      <div class="posts-grid reveal-stagger">
        {latestPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            pubDate={post.data.pubDate}
            author={post.data.author}
            tags={post.data.tags}
          />
        ))}
      </div>
      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/blog" class="btn">Ver todos os posts</a>
      </div>
    </div>
  </section>

  <!-- Onde estamos -->
  <section class="section location-section">
    <div class="container">
      <h2 class="section-title reveal">Onde estamos</h2>
      <p class="section-subtitle reveal">No Pina, com acesso fácil pela Av. Boa Viagem. E se você não puder vir, a gente busca o aparelho em Recife.</p>
      <div class="location-grid reveal-stagger">
        <div class="why-card">
          <h3>Endereço</h3>
          <p>Av. Antônio de Góes, 14 — Pina<br />Recife/PE — CEP 51110-000</p>
        </div>
        <div class="why-card">
          <h3>Horário</h3>
          <p>Segunda a sexta: 9h às 18h30<br />Sábado: 9h às 17h</p>
        </div>
        <div class="why-card">
          <h3>Contato</h3>
          <p>WhatsApp (81) 99186-2060<br />grupoconectaphone@gmail.com</p>
        </div>
      </div>
      <div style="text-align:center; margin-top:2rem;">
        <a href="/sobre" class="btn-outline location-link">Conheça a Conecta Phone</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Seu <span class="grad">aparelho</span> com problema? Fale agora!</h2>
      <p>Apple, Samsung, Motorola ou JBL — atendemos na loja do Pina ou pelo WhatsApp.</p>
      <a
        href="https://wa.me/5581991862060?text=Olá%2C%20vim%20do%20blog%20Conecta%20e%20preciso%20de%20um%20or%C3%A7amento%20gr%C3%A1tis"
        class="btn-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        Chamar no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<style>
