  <script>
    // Abas acessíveis reutilizáveis (clique, setas, Home/End)
    const wireTabs = (tabs, onSelect, isVertical) => {
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => onSelect(tab, false));
        tab.addEventListener('keydown', (e) => {
          const vertical = isVertical();
          const next = vertical ? 'ArrowDown' : 'ArrowRight';
          const prev = vertical ? 'ArrowUp' : 'ArrowLeft';
          let j = null;
          if (e.key === next) j = (i + 1) % tabs.length;
          if (e.key === prev) j = (i - 1 + tabs.length) % tabs.length;
          if (e.key === 'Home') j = 0;
          if (e.key === 'End') j = tabs.length - 1;
          if (j !== null) { e.preventDefault(); onSelect(tabs[j], true); }
        });
      });
    };

    const showPanel = (panel, on) => {
      if (!panel) return;
      if (on) {
        const img = panel.querySelector('img');
        if (img) img.loading = 'eager';
        panel.hidden = false;
        panel.classList.remove('is-active');
        void panel.offsetWidth; // reinicia a animação de entrada
        panel.classList.add('is-active');
      } else {
        panel.hidden = true;
        panel.classList.remove('is-active');
      }
    };

    const setSelected = (tabs, tab) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
    };

    const keepInView = (list, tab) => {
      if (!list || list.scrollWidth <= list.clientWidth) return;
      // rola só se a aba estiver fora da área visível (rolagem instantânea, sem animar)
      const left = tab.offsetLeft, right = left + tab.offsetWidth;
      if (left < list.scrollLeft || right > list.scrollLeft + list.clientWidth) {
        list.scrollLeft = Math.max(0, left - 16);
      }
    };

    // Seletor de serviços de um aparelho
    const pickers = Array.from(document.querySelectorAll('[data-picker]')).map((picker) => {
      const tabs = Array.from(picker.querySelectorAll('.picker-tab'));
      const glow = picker.querySelector('.picker-glow');
      const list = picker.querySelector('.picker-tabs');
      const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') || tabs[0];

      const moveGlow = () => {
        const tab = current();
        if (!glow || !tab || !tab.offsetWidth) return;
        glow.style.transform = 'translate(' + tab.offsetLeft + 'px, ' + tab.offsetTop + 'px)';
        glow.style.width = tab.offsetWidth + 'px';
        glow.style.height = tab.offsetHeight + 'px';
      };

      const select = (tab, focus) => {
        setSelected(tabs, tab);
        tabs.forEach((t) => showPanel(document.getElementById(t.getAttribute('aria-controls')), t === tab));
        moveGlow();
        if (focus) tab.focus();
        keepInView(list, tab);
      };

      wireTabs(tabs, select, () => window.matchMedia('(min-width: 900px)').matches);
      moveGlow();
      requestAnimationFrame(() => picker.classList.add('is-ready'));
      return { picker, moveGlow };
    });

    window.addEventListener('resize', () => pickers.forEach((p) => p.moveGlow()));

    // Troca de aparelho
    const deviceTabs = Array.from(document.querySelectorAll('.device-tab'));
    const deviceList = document.querySelector('.device-switch');
    const selectDevice = (tab, focus) => {
      setSelected(deviceTabs, tab);
      deviceTabs.forEach((t) => {
        const group = document.getElementById(t.getAttribute('aria-controls'));
        if (!group) return;
        group.hidden = t !== tab;
        if (t === tab) {
          const p = pickers.find((x) => group.contains(x.picker));
          if (p) {
            // espera o grupo ser desenhado antes de posicionar o destaque e animar o painel
            requestAnimationFrame(() => {
              p.moveGlow();
              const active = group.querySelector('.picker-panel:not([hidden])');
              showPanel(active, true);
            });
          }
        }
      });
      if (focus) tab.focus();
      keepInView(deviceList, tab);
    };
    wireTabs(deviceTabs, selectDevice, () => false);

    // Pré-carrega as fotos quando a seção chega perto da tela
    const section = document.querySelector('.services-picker');
    if (section) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          section.querySelectorAll('.picker-media img').forEach((img) => { img.loading = 'eager'; });
          io.disconnect();
        }
      }, { rootMargin: '400px' });
      io.observe(section);
    }
  </script>

