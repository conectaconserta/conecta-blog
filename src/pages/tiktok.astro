---
import '../styles/global.css';

const whatsNumber = '5581989643974';
const whatsMessage = 'Oi! vim pelo TikTok e quero um orçamento gratuito';
const whatsLink = `https://wa.me/${whatsNumber}?text=${encodeURIComponent(whatsMessage)}`;

/* Marcas do título rotativo — a primeira é repetida no fim para o loop ficar contínuo */
const brands = ['Apple', 'Samsung', 'Motorola', 'Xiaomi'];

const links = [
  {
    href: 'https://maps.google.com/maps?q=Av.+Ant%C3%B4nio+de+G%C3%B3es%2C+14%2C+Pina%2C+Recife%2C+PE',
    label: 'Como chegar',
    desc: 'Av. Antônio de Góes, 14 — Pina, Recife',
    external: true,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    href: 'https://share.google/rktOQ5pgkn5dEPEh1',
    label: 'Avaliações no Google',
    desc: '4,9 ★ com mais de 800 avaliações',
    external: true,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/></svg>`,
  },
  {
    href: `tel:+${whatsNumber}`,
    label: 'Ligar agora',
    desc: '(81) 98964-3974',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3Z"/></svg>`,
  },
];

const badges = [
  'Orçamento grátis',
  'Garantia de 3 a 6 meses',
  'Coleta e entrega',
  'Reparo no mesmo dia',
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conecta Phone — Assistência Técnica em Recife</title>
    <meta
      name="description"
      content="Assistência técnica Apple, Samsung, Motorola e Xiaomi em Recife. Orçamento grátis pelo WhatsApp."
    />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0a1e30" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Conecta Phone — Assistência Técnica em Recife" />
    <meta
      property="og:description"
      content="Assistência técnica Apple, Samsung, Motorola e Xiaomi em Recife. Orçamento grátis pelo WhatsApp."
    />
    <meta property="og:image" content="/images/logo.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KZQJ1SKWSJ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KZQJ1SKWSJ');
    </script>
  </head>

  <body class="bio-body">
    <main class="bio">
      <div class="bio-glow" aria-hidden="true"></div>

      <header class="bio-head">
        <img
          src="/images/footer-logo.png"
          alt="Conecta Phone"
          class="bio-logo"
          width="200"
          height="50"
        />
        <h1>
          <span class="bio-h1-fixed">Assistência Técnica</span>
          <span class="rot" aria-label="Apple, Samsung, Motorola e Xiaomi">
            <span class="rot-track">
              {brands.map(b => <span class="grad">{b}</span>)}
              <span class="grad">{brands[0]}</span>
            </span>
          </span>
        </h1>
        <p class="bio-lead">
          Recife/PE · Celular, tablet e notebook.<br />
          Diagnóstico gratuito, peças de qualidade e garantia em todos os reparos.
        </p>

        <div class="bio-rating">
          <svg class="bio-google" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span class="bio-stars">★★★★★</span>
          <strong>4,9</strong>
          <span class="bio-count">· 800+ avaliações</span>
        </div>
      </header>

      <a
        href={whatsLink}
        class="bio-cta"
        target="_blank"
        rel="noopener noreferrer"
        data-whats
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>
          <strong>Falar no WhatsApp</strong>
          <em>Orçamento grátis em minutos</em>
        </span>
      </a>

      <ul class="bio-badges">
        {badges.map(b => <li>{b}</li>)}
      </ul>

      <nav class="bio-links">
        {links.map(l => (
          <a
            href={l.href}
            class="bio-link"
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener noreferrer' : undefined}
          >
            <span class="bio-link-icon" set:html={l.icon} />
            <span class="bio-link-text">
              <strong>{l.label}</strong>
              <em>{l.desc}</em>
            </span>
            <svg class="bio-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 5 7 7-7 7"/>
            </svg>
          </a>
        ))}
      </nav>

      <footer class="bio-foot">
        <p>Seg–Sex: 09h–18h30 · Sáb: 09h–17h</p>
        <p>Av. Antônio de Góes, 14 — Pina, Recife/PE</p>
      </footer>
    </main>

    <a
      href={whatsLink}
      class="bio-sticky"
      target="_blank"
      rel="noopener noreferrer"
      data-whats
    >
      Quero meu orçamento grátis
    </a>

    <script is:inline>
      document.addEventListener('click', function (e) {
        if (e.target.closest('a[data-whats]')) {
          gtag('event', 'whatsapp_click', {
            event_category: 'conversao',
            event_label: 'tiktok_bio',
          });
        }
      });
    </script>
  </body>
</html>

<style>
  .bio-body {
    background: linear-gradient(165deg, #14334F 0%, #0a1e30 55%, #071726 100%);
    background-attachment: fixed;
    color: rgba(255, 255, 255, 0.72);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  .bio {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    padding: 3rem 1.25rem 7.5rem;
    z-index: 1;
  }

  .bio-glow {
    position: fixed;
    top: -220px;
    left: 50%;
    width: 620px;
    height: 620px;
    max-width: 150vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(31, 195, 255, 0.22) 0%, transparent 68%);
    pointer-events: none;
    z-index: 0;
    animation: blob-pulse 8s ease-in-out infinite;
  }

  /* ── Cabeçalho ── */
  .bio-head {
    text-align: center;
    margin-bottom: 2rem;
  }

  .bio-logo {
    height: 52px;
    width: auto;
    margin: 0 auto 1.5rem;
    object-fit: contain;
  }

  .bio-head h1 {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-size: clamp(1.6rem, 6.4vw, 2.2rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 0.85rem;
  }

  .bio-h1-fixed { display: block; }

  /* ── Marca rotativa (rola de baixo para cima) ── */
  .rot {
    display: block;
    height: 1.3em;
    overflow: hidden;
  }

  .rot-track {
    display: flex;
    flex-direction: column;
    animation: rot-roll 9s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    will-change: transform;
  }

  .rot-track > span {
    display: block;
    height: 1.3em;
    line-height: 1.3em;
    flex-shrink: 0;
  }

  @keyframes rot-roll {
    0%,   20% { transform: translateY(0); }
    25%,  45% { transform: translateY(-1.3em); }
    50%,  70% { transform: translateY(-2.6em); }
    75%,  95% { transform: translateY(-3.9em); }
    100%      { transform: translateY(-5.2em); }
  }

  .bio-lead {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    max-width: 400px;
    margin: 0 auto;
  }

  .bio-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.25rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.82rem;
  }

  .bio-google { width: 1rem; height: 1rem; flex-shrink: 0; }
  .bio-stars { color: #FBBC05; letter-spacing: 0.03em; }
  .bio-rating strong {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    color: #fff;
  }
  .bio-count { color: rgba(255, 255, 255, 0.55); }

  /* ── CTA principal ── */
  .bio-cta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: #25D366;
    color: #fff;
    text-decoration: none;
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.32);
    transition: transform 0.2s var(--ease-spring), box-shadow 0.2s ease, background 0.2s;
    animation: whatsapp-pulse 3s ease-in-out infinite;
  }

  .bio-cta:hover {
    background: #1fad54;
    text-decoration: none;
    color: #fff;
    transform: translateY(-2px);
  }

  .bio-cta svg { width: 30px; height: 30px; flex-shrink: 0; }

  .bio-cta strong {
    display: block;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .bio-cta em {
    display: block;
    font-style: normal;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.1rem;
  }

  /* ── Selos ── */
  .bio-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.25rem 0 2rem;
  }

  .bio-badges li {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cyan);
    background: rgba(31, 195, 255, 0.12);
    border: 1px solid rgba(31, 195, 255, 0.28);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
  }

  /* ── Links secundários ── */
  .bio-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bio-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: #fff;
    transition: background 0.25s, border-color 0.25s, transform 0.25s var(--ease-spring);
  }

  .bio-link:hover {
    background: rgba(31, 195, 255, 0.1);
    border-color: rgba(31, 195, 255, 0.4);
    transform: translateY(-2px);
    text-decoration: none;
    color: #fff;
  }

  .bio-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgba(31, 195, 255, 0.9) 0%, rgba(0, 153, 204, 0.75) 100%);
    color: #06202f;
  }

  .bio-link-icon :global(svg) { width: 1.2rem; height: 1.2rem; }

  .bio-link-text { flex: 1; min-width: 0; }

  .bio-link-text strong {
    display: block;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
  }

  .bio-link-text em {
    display: block;
    font-style: normal;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 0.1rem;
  }

  .bio-link-arrow {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.35);
    transition: transform 0.25s, color 0.25s;
  }

  .bio-link:hover .bio-link-arrow {
    color: var(--cyan);
    transform: translateX(3px);
  }

  /* ── Rodapé ── */
  .bio-foot {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.42);
    line-height: 1.8;
  }

  /* ── Barra fixa ── */
  .bio-sticky {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    width: calc(100% - 2.5rem);
    max-width: 420px;
    z-index: 50;
    text-align: center;
    background: var(--green);
    color: #fff;
    padding: 0.9rem 1.25rem;
    border-radius: var(--radius-pill);
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
    transition: background 0.2s, transform 0.2s;
  }

  .bio-sticky:hover {
    background: var(--green-dark);
    color: #fff;
    text-decoration: none;
    transform: translateX(-50%) translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-glow, .bio-cta, .rot-track { animation: none !important; }
    .rot { height: auto; }
    .rot-track > span:not(:first-child) { display: none; }
  }
</style>
